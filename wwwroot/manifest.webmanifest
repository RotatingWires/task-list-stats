      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/touch-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
