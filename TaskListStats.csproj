<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TaskListStats</AssemblyName>
    <RootNamespace>TaskListStats</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.1.12</Version>
    <Product>TaskList Stats</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>
  <Target Name="GenerateWebVersion" BeforeTargets="Build">
    <WriteLinesToFile
      File="$(MSBuildProjectDirectory)/wwwroot/version.json"
      Lines="{&quot;version&quot;:&quot;$(Version)&quot;}"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>
</Project>
